{
  "name": "ps-review",
  "description": "Browser extension for Pokemon Showdown: per-battle rating context and performance review.",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "replays:download": "tsx scripts/download-replays.ts",
    "dataset:build": "tsx scripts/build-dataset.ts",
    "model:train": "tsx scripts/train-model.ts",
    "sim:verify": "tsx scripts/verify-sim.ts",
    "sim:setup": "tsx scripts/setup-sim.ts",
    "review:game": "tsx scripts/review-game.ts",
    "states:build": "tsx scripts/build-states.ts",
    "selfplay": "tsx scripts/self-play.ts",
    "model:train-rich": "tsx scripts/train-rich.ts"
  },
  "devDependencies": {
    "@pkmn/randoms": "^0.10.11",
    "@pkmn/sim": "^0.10.11",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  }
}
